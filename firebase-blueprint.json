{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "A client of the business",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "responsavel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "A service offered by the business",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "valor": { "type": "number" },
        "descricao": { "type": "string" },
        "responsavel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "valor", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction (income or expense)",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "valor": { "type": "number" },
        "descricao": { "type": "string" },
        "servico": { "type": "string" },
        "cliente": { "type": "string" },
        "data": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "received"] },
        "responsavel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "valor", "data", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled task or meeting",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "cliente": { "type": "string" },
        "data": { "type": "string", "format": "date" },
        "hora": { "type": "string" },
        "responsavel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titulo", "data", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}/clients": {
      "schema": "Client",
      "description": "Colletion of clients for a user"
    },
    "users/{userId}/services": {
      "schema": "Service",
      "description": "Colletion of services for a user"
    },
    "users/{userId}/transactions": {
      "schema": "Transaction",
      "description": "Colletion of financial transactions for a user"
    },
    "users/{userId}/appointments": {
      "schema": "Appointment",
      "description": "Colletion of appointments for a user"
    }
  }
}
